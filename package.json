{
  "name": "helene",
  "description": "A minimal code editor",
  "type": "module",
  "version": "0.1.0",
  "source": [
    "src/helene.mjs"
  ],
  "main": "src/helene.mjs",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build-dev": "./node_modules/.bin/esbuild src/helene.mjs --bundle --format=esm --sourcemap --outfile=dist/helene.js",
    "build": "./node_modules/.bin/esbuild src/helene.mjs --bundle --format=esm --sourcemap --outfile=dist/helene.min.js --minify",
    "watch": "watch 'npm run build-dev' ./src & npx http-server www/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muze-nl/helene.git"
  },
  "author": "auke@muze.nl",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/muze-nl/helene/issues"
  },
  "homepage": "https://github.com/muze-nl/helene/#readme",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "watch": "^1.0.2"
  },
  "dependencies": {
  }
}
